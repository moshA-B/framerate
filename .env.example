# Copy this file to a new file called .env and replace the values. Never commit .env.
# Everything below is a fake placeholder.

# Database (used by docker-compose.yml)
POSTGRES_DB=framerate
POSTGRES_USER=framerate
POSTGRES_PASSWORD=change_me

# Secret that signs login tokens. Make it long and random, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string_of_32_plus_characters

# Your key from themoviedb.org (Settings > API)
TMDB_API_KEY=your_tmdb_key_here

# The first manager account, created automatically when the backend starts
MANAGER_USERNAME=manager
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=change_me_too
